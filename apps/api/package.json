{
  "name": "@nibbl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "migrate": "wrangler d1 migrations apply nibbl --local",
    "migrate:remote": "wrangler d1 migrations apply nibbl --remote",
    "gen:bots": "tsx scripts/gen-bot-migration.ts",
    "provision": "bash scripts/provision.sh",
    "secrets": "bash scripts/set-secrets.sh",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@nibbl/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
